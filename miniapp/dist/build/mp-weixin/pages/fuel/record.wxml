<view class="container data-v-3a9d1d9d"><view class="form-card data-v-3a9d1d9d"><view class="form-title data-v-3a9d1d9d">加油登记</view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">加油时间</text><picker class="data-v-3a9d1d9d" mode="multiSelector" range="{{b}}" value="{{c}}" bindchange="{{d}}"><view class="picker data-v-3a9d1d9d">{{a}}</view></picker></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">油品</text><input class="input data-v-3a9d1d9d" placeholder="如 0#柴油" value="{{e}}" bindinput="{{f}}"/></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">加油量（升）</text><input type="digit" class="input data-v-3a9d1d9d" placeholder="请输入加油量" value="{{g}}" bindinput="{{h}}"/></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">单价</text><input type="digit" class="input data-v-3a9d1d9d" placeholder="请输入单价" value="{{i}}" bindinput="{{j}}"/></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">当前台时读数</text><input type="digit" class="input data-v-3a9d1d9d" placeholder="请输入台时读数" value="{{k}}" bindinput="{{l}}"/></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">加油人</text><input class="input data-v-3a9d1d9d" placeholder="请输入姓名" value="{{m}}" bindinput="{{n}}"/></view><view class="form-item data-v-3a9d1d9d"><text class="label data-v-3a9d1d9d">小票照片</text><button class="photo-btn data-v-3a9d1d9d" bindtap="{{o}}">选择照片</button><image wx:if="{{p}}" src="{{q}}" class="preview data-v-3a9d1d9d" mode="aspectFit"/></view><button class="submit-btn data-v-3a9d1d9d" bindtap="{{r}}">提 交</button></view></view>