<view class="container data-v-c339f939"><view class="header-card data-v-c339f939"><view class="title data-v-c339f939">设备管理系统</view><view class="subtitle data-v-c339f939">扫码即可操作设备</view></view><view class="scan-area data-v-c339f939" bindtap="{{a}}"><view class="scan-icon data-v-c339f939"><text class="iconfont data-v-c339f939"></text></view><view class="scan-text data-v-c339f939">点击扫描二维码</view><view class="scan-tip data-v-c339f939">请对准设备上的二维码</view></view><view class="manual-input data-v-c339f939"><input placeholder="或输入设备编号" class="code-input data-v-c339f939" value="{{b}}" bindinput="{{c}}"/><button class="mini-btn data-v-c339f939" bindtap="{{d}}">查询</button></view><view class="todo-area data-v-c339f939"><view class="todo-title data-v-c339f939">待办事项</view><view class="todo-list data-v-c339f939"><view class="todo-item data-v-c339f939" bindtap="{{f}}"><text class="num data-v-c339f939">{{e}}</text><text class="label data-v-c339f939">维保提醒</text></view><view class="todo-item data-v-c339f939"><text class="num data-v-c339f939">{{g}}</text><text class="label data-v-c339f939">我的报修</text></view><view class="todo-item data-v-c339f939"><text class="num data-v-c339f939">{{h}}</text><text class="label data-v-c339f939">待培训</text></view></view></view><view class="menu-grid data-v-c339f939"><view wx:for="{{i}}" wx:for-item="item" wx:key="c" class="grid-item data-v-c339f939" bindtap="{{item.d}}"><text class="grid-icon data-v-c339f939">{{item.a}}</text><text class="grid-label data-v-c339f939">{{item.b}}</text></view></view></view>